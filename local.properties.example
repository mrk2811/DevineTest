# Copy this file to local.properties and fill in your values.
# DO NOT commit local.properties to version control.

# Android SDK location (Android Studio sets this automatically)
sdk.dir=/path/to/your/Android/Sdk

# Google Maps API Key
# Get yours at: https://console.cloud.google.com/apis/credentials
# Enable "Maps SDK for Android" in your Google Cloud project
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
